NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/smart-campus-lost-and-found
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=campusfind_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
VERIFICATION_TOKEN_EXPIRES_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CampusFind <your Gmail address>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campusfind/reports
MATCH_WEIGHT_CATEGORY=25
MATCH_WEIGHT_NAME=25
MATCH_WEIGHT_DESCRIPTION=15
MATCH_WEIGHT_LOCATION=15
MATCH_WEIGHT_DATE=10
MATCH_WEIGHT_ATTRIBUTES=10
MATCH_DATE_WINDOW_DAYS=30
MATCH_MINIMUM_SCORE=25
MATCH_DEFAULT_LIMIT=10
MATCH_MAX_LIMIT=50

